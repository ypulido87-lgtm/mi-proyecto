DirectoryIndex index.html index.php
# Block the include-only files.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
RewriteRule ^wp-admin/includes/ - [F,L]
RewriteRule !^wp-includes/ - [S=3]
RewriteRule ^wp-includes/[^/]+\.php$ - [F,L]
RewriteRule ^wp-includes/js/tinymce/langs/.+\.php - [F,L]
RewriteRule ^wp-includes/theme-compat/ - [F,L]
</IfModule>
<Files wp-config.php>
<IfModule !mod_authz_core.c>
order allow,deny
deny from all
</IfModule>
<IfModule mod_authz_core.c>
require all denied
</IfModule>
</Files>

RewriteRule ^landing\.html$ - [L]

# ===== Paginas de ejemplo de WordPress (2026-10-23) =====
# WordPress sigue instalado y dejo vivas "Sample Page" y "Hello world!", con el
# titulo "My blog". Estaban ademas en el sitemap que se le declaraba a Google.
# Se redirigen al inicio con 301 para que Google las deje de indexar y nadie
# aterrice en ellas. NO deben bloquearse en robots.txt: si se bloquean, el
# rastreador no llega a ver la redireccion y las deja indexadas.
RewriteRule ^sample-page/?$ / [R=301,L]
RewriteRule ^uncategorized/hello-world/?$ / [R=301,L]
RewriteRule ^uncategorized/?$ / [R=301,L]
# ===== Fin paginas de ejemplo =====

# ===== Markdown for AI agents + Link header (added 2026-09-03) =====
<IfModule mod_mime.c>
AddType text/markdown .md
AddCharset utf-8 .md
</IfModule>
<IfModule mod_rewrite.c>
RewriteCond %{DOCUMENT_ROOT}/index.md -f
RewriteRule ^$ - [E=MDFILE:index.md]

RewriteCond %{DOCUMENT_ROOT}/$1.md -f
RewriteRule ^([a-z0-9-]+)\.html$ - [E=MDFILE:$1.md]

RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
RewriteCond %{DOCUMENT_ROOT}/index.md -f
RewriteRule ^$ index.md [L]

RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
RewriteCond %{DOCUMENT_ROOT}/$1.md -f
RewriteRule ^([a-z0-9-]+)\.html$ $1.md [L]
</IfModule>
<IfModule mod_headers.c>
Header set Link "<https://pulidotax.com/%{MDFILE}e>; rel=\"alternate\"; type=\"text/markdown\", <https://pulidotax.com/sitemap.xml>; rel=\"sitemap\"" env=MDFILE
</IfModule>
# ===== End Markdown for AI agents =====

# ===== URLs sin extension, pagina 404 propia y WordPress desactivado (2026-10-25) =====
# /calculadora muestra calculadora.html (y asi todas las paginas). Las URLs con .html siguen funcionando.
# WordPress sigue instalado pero ya NO atiende el sitio: se quito su regla que mandaba
# todo lo que no existe a index.php (eso mostraba la pagina 404 "My blog"). Archivos intactos.
ErrorDocument 404 /404.html
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^index\.php$ / [R=301,L]
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([a-z0-9-]+)$ $1.html [L]
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([a-z0-9-]+)/$ /$1 [R=301,L]
</IfModule>
